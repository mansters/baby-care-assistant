*.user
*.userosscache
*.sln.docstates

# Security: Never commit development secrets
appsettings.Development.json
appsettings.Local.json
*.pem

# =========================
# FRONTEND (Next.js)
# =========================
# Dependencies
node_modules
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
build/
.vercel

# Testing & Typescript
coverage/
*.tsbuildinfo
next-env.d.ts

# Security: Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
