# AWS Profile and Region
AWS_PROFILE=default
AWS_REGION=ap-northeast-1
AWS_ACCOUNT_ID=123456789012

# Lambda Configuration
LAMBDA_FUNCTION_NAME=baby-care-api
LAMBDA_SSR_ROLE_NAME=baby-care-amplify-ssr-compute-role
LAMBDA_EXECUTION_ROLE_NAME=baby-care-api-role
LAMBDA_MEMORY_SIZE=512
LAMBDA_TIMEOUT=30

# Backend Environment Variables
ASPNETCORE_ENVIRONMENT=Production

# Cognito Configuration
COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=ap-northeast-1

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=BabyCare·
DYNAMODB_REGION=ap-northeast-1
DYNAMODB_GSI1_NAME=GSI1PK-GSI1SK-index
